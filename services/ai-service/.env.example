# ==============================================================================
# AI Service Environment Configuration (.env.example)
# Duplicate this file as `.env` inside `services/ai-service/`
# ==============================================================================

# App Configuration
APP_NAME=AI-Service
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# AI Model Provider Keys (Provide any key to activate live LLM completion)
# If left as placeholder, the internal calibrated heuristic engine runs seamlessly (zero crashes)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Active Model & Embeddings Settings
DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_FALLBACK_MODE=true

# Storage & Cache (Optional)
REDIS_URL=redis://localhost:6379/0
VECTOR_DB_URL=http://localhost:6333
