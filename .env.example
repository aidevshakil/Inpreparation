# ==============================================================================
# Global / Master Monorepo Environment Configuration (.env.example)
# Duplicate this file as `.env` in the project root and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Prisma ORM - PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/inpreparation_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Main API Backend (Node.js / Express - Port 5000)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000/api/v1
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Auth: REQUIRED in production. Long random string used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-secret

# CORS allowlist for the API backend. Comma-separated origins.
# In production, MUST be set explicitly; otherwise no origins are allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# 3. AI Service (Python / FastAPI Microservice - Port 8000)
# ------------------------------------------------------------------------------
APP_NAME=AI-Service
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# AI Model Provider Keys (Provide any key to activate live LLM completion)
# If left empty or with placeholder, the internal calibrated heuristic engine runs seamlessly
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Active Model & Embeddings Settings
DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_FALLBACK_MODE=true

# Cache & Vector Database (Optional)
REDIS_URL=redis://localhost:6379/0
VECTOR_DB_URL=http://localhost:6333

# ------------------------------------------------------------------------------
# 4. Web Frontend (React / Vite - Port 3000)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_AI_SERVICE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. Admin Dashboard (React / Vite - Port 5173 / 3002)
# ------------------------------------------------------------------------------
VITE_ADMIN_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 6. Email Delivery / SMTP Configuration (Gmail App Password)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Inprep AI <your_email@gmail.com>"
