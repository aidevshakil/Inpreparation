# ==============================================================================
# Global / Master Monorepo Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Prisma ORM)
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/inprep_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Main API Backend (Node.js / Express)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 3. AI Service (Python / FastAPI)
# ------------------------------------------------------------------------------
APP_NAME=AI-Service
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# AI Model Keys & Config
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cache & Vector Database
REDIS_URL=redis://localhost:6379/0
VECTOR_DB_URL=http://localhost:6333

# ------------------------------------------------------------------------------
# 4. Web Frontend (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_AI_SERVICE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 5. Admin Dashboard (React / Vite)
# ------------------------------------------------------------------------------
VITE_ADMIN_API_URL=http://localhost:5000/api
